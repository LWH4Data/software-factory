# Allow only the ten distribution files. Review forced additions and already tracked files separately.
*
!/.gitignore
!/.gitattributes
!/README.md
!/README.ko.md
!/requirements-dev.txt
!/.agents/
!/.agents/plugins/
!/.agents/plugins/marketplace.json
!/software-factory/
!/software-factory/plugin.json
!/software-factory/skills/
!/software-factory/skills/software-factory/
!/software-factory/skills/software-factory/SKILL.md
!/software-factory/skills/software-factory/references/
!/software-factory/skills/software-factory/references/cycle-close-checklist.md
!/software-factory/skills/software-factory/references/operating-examples.md

# Exclude operational records, virtual environments, authentication, secrets, environment files, and temporary files.
**/records/
**/work/
**/outputs/
**/.venv/
**/venv/
**/env/
**/auth/
**/.auth/
**/secrets/
**/tmp/
**/temp/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.swp
**/*~
